<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WA Forward"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Teruskan notifikasi WhatsApp / SMS di HP ini ke gateway. Isi URL gateway + API key kamu sendiri."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Status: —"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sesi"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gateway URL"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://IP-VPS:3000/otp/ingest"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="API Key (Worker)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key Worker dari bot Telegram"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nomor HP ini (bisa banyak)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ketik nomor, mis. 6281xxxx"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAddTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvToNumbers"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nomor untuk Buka WA (bisa banyak)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etOpenWaNum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ketik nomor, mis. 62812xxxx"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAddNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvNumbers"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap nomor di daftar untuk hapus"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pilih WA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spWaChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etClonePkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Package name WA Clone"
            android:inputType="text"
            android:visibility="gone" />

        <Switch
            android:id="@+id/swForwardWa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="Forward notifikasi WhatsApp" />

        <Switch
            android:id="@+id/swForwardSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Forward notifikasi SMS" />

        <Switch
            android:id="@+id/swOpenWa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Buka WhatsApp saat notifikasi masuk" />

        <Switch
            android:id="@+id/swAutoOpenOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Auto-buka chat dari order bot Telegram" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Simpan Pengaturan" />

        <Button
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Buka Izin Notifikasi" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mulai Service" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cara pakai:\n1. Isi Gateway URL + API Key + nomor HP ini, Simpan.\n2. Tap 'Buka Izin Notifikasi' → aktifkan WA Forward.\n3. Tap 'Mulai Service'.\n4. Matikan optimasi baterai untuk app ini agar tidak dibunuh Android."
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
